<!DOCTYPE html>
<html lang="zh">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>22号 · Tarot & Transmission</title>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;1,300;1,400&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
<style>
*, *::before, *::after { margin:0; padding:0; box-sizing:border-box; }
:root { --gold:#c9a84c; --gold-dim:#c9a84c44; --bg:#0a0a08; --surface:#0e0e0a; --border:#2a2a20; --border-dim:#1e1e16; --text:#e0dace; --text-muted:#9a9080; --text-faint:#5a5448; --text-ghost:#3a3a2e; --purple-dim:#7a4a9044;}
html,body{height:100%; background:var(--bg); color:var(--text); font-family:'Cormorant Garamond',serif; overflow-x:hidden;}
body{display:flex; flex-direction:column; align-items:center; min-height:100vh;}
.header{width:100%; max-width:720px; padding:1.5rem 1rem 1rem; display:flex; justify-content:space-between; align-items:flex-end; border-bottom:0.5px solid var(--border);}
.logo{font-size:2.5rem; font-weight:300; font-style:italic; letter-spacing:-0.02em; line-height:1; color:var(--text);}
.logo span{color:var(--gold);}
.header-right{display:flex; flex-direction:column; align-items:flex-end; gap:0.2rem; padding-bottom:0.2rem;}
.brand{font-family:'Space Mono',monospace; font-size:8px; letter-spacing:0.2em; color:var(--text-faint); text-transform:uppercase;}
.tagline{font-family:'Space Mono',monospace; font-size:8px; color:var(--text-ghost); letter-spacing:0.1em;}
.main{width:100%; max-width:720px; padding:0 1rem; flex:1; display:flex; flex-direction:column;}
.chat-area{flex:1; padding:1rem 0 1rem; display:flex; flex-direction:column; gap:1rem; min-height:400px; max-height:60vh; overflow-y:auto; scrollbar-width:thin; scrollbar-color:var(--border) transparent;}
.chat-area::-webkit-scrollbar{width:4px;}
.chat-area::-webkit-scrollbar-thumb{background:var(--border);}
.message{display:flex; flex-direction:column; gap:0.3rem; animation:fadeUp 0.4s ease forwards; opacity:0;}
@keyframes fadeUp{from{opacity:0; transform:translateY(8px);}to{opacity:1; transform:translateY(0);}}
.message.user{align-items:flex-end;}
.message.ai{align-items:flex-start;}
.msg-label{font-family:'Space Mono',monospace; font-size:8px; letter-spacing:0.2em; color:var(--text-faint); text-transform:uppercase;}
.msg-bubble{max-width:90%; line-height:1.7; font-size:1rem; font-weight:300;}
.message.user .msg-bubble{color:var(--text-muted); text-align:right; font-style:italic;}
.message.ai .msg-bubble{color:var(--text);}
.typing{color:var(--text-ghost); font-style:italic;}
.cards-row{display:flex; gap:0.4rem; flex-wrap:wrap; align-items:flex-start;}
.tarot-card{width:48px; height:80px; border:0.5px solid var(--border-dim); border-radius:3px; display:flex; flex-direction:column; align-items:center; justify-content:center; background:var(--surface); position:relative; transition:border-color 0.4s;}
.tarot-card.face-down::after{content:''; display:block; width:34px; height:58px; border:0.5px solid #222218; border-radius:2px;}
.tarot-card.face-down .card-inner{display:none;}
.tarot-card.revealed{border-color:var(--gold-dim); animation:flipIn 0.5s ease forwards;}
.tarot-card.reversed{border-color:var(--purple-dim);}
@keyframes flipIn{0%{transform:rotateY(90deg); opacity:0;}100%{transform:rotateY(0deg); opacity:1;}}
.card-inner{display:flex; flex-direction:column; align-items:center; gap:3px; padding:4px;}
.tarot-card.reversed .card-inner{transform:rotate(180deg);}
.card-symbol{font-size:18px; line-height:1; color:var(--gold);}
.card-name-sm{font-family:'Space Mono',monospace; font-size:6px; color:var(--text-faint); text-align:center; line-height:1.3;}
.card-ori-sm{font-family:'Space Mono',monospace; font-size:6px; color:#7a4a90aa;}
.bottom-bar{border-top:0.5px solid var(--border); padding:0.75rem 0 1.5rem; display:flex; flex-direction:column; gap:0.5rem;}
.toolbar{display:flex; gap:0.3rem; align-items:center; flex-wrap:wrap;}
.tool-label{font-family:'Space Mono',monospace; font-size:7px; color:var(--text-faint); letter-spacing:0.12em; text-transform:uppercase;}
.tool-btn{font-family:'Space Mono',monospace; font-size:7px; letter-spacing:0.08em; color:var(--text-faint); border:0.5px solid var(--border-dim); padding:0.25rem 0.6rem; cursor:pointer; background:transparent; transition:all 0.2s; text-transform:uppercase;}
.tool-btn:hover{color:var(--gold); border-color:var(--gold-dim);}
.tool-btn.active{color:var(--gold); border-color:var(--gold-dim);}
.quick-row{display:flex; gap:0.3rem; flex-wrap:wrap;}
.qp{font-family:'Space Mono',monospace; font-size:7px; letter-spacing:0.06em; color:var(--text-ghost); border:0.5px solid var(--border-dim); padding:0.25rem 0.5rem; cursor:pointer; transition:all 0.2s; background:transparent; text-transform:uppercase;}
.qp:hover{color:var(--text-muted); border-color:var(--border);}
.input-row{display:flex; gap:0.5rem; align-items:flex-end;}
textarea{flex:1; background:transparent; border:none; border-bottom:0.5px solid var(--border); color:var(--text); font-family:'Cormorant Garamond',serif; font-size:1rem; font-weight:300; line-height:1.6; resize:none; outline:none; padding:0.35rem 0; min-height:36px; max-height:96px;}
textarea::placeholder{color:var(--text-ghost); font-style:italic;}
textarea:focus{border-bottom-color:var(--gold-dim);}
.send-btn{background:transparent; border:0.5px solid var(--border); color:var(--text-faint); font-family:'Space Mono',monospace; font-size:7px; letter-spacing:0.15em; text-transform:uppercase; padding:0.35rem 0.8rem; cursor:pointer; transition:all 0.2s; white-space:nowrap; height:36px;}
.send-btn:hover{border-color:var(--gold-dim); color:var(--gold);}
.send-btn:active{transform:scale(0.98);}
</style>
</head>
<body>
<div class="header">
  <div class="logo"><span>22</span></div>
  <div class="header-right">
    <div class="brand">No. 22 · Tarot & Transmission</div>
    <div class="tagline">speak freely · see clearly</div>
  </div>
</div>

<div class="main">
  <div class="chat-area" id="chatArea">
    <div class="message ai" style="animation-delay:0.15s">
      <div class="msg-label">22</div>
      <div class="msg-bubble">你想问什么嘞，最近有什么困惑？事业爱情财运，或者就是一种说不清楚的感觉——都可以。</div>
    </div>
  </div>

  <div class="bottom-bar">
    <div class="toolbar">
      <span class="tool-label">牌阵</span>
      <button class="tool-btn active" id="btn-default" onclick="setSpread('default')">指导 + 三情况</button>
      <button class="tool-btn" id="btn-cross" onclick="setSpread('cross')">恋人十字</button>
      <button class="tool-btn" id="btn-single" onclick="setSpread('single')">单张</button>
    </div>
    <div class="quick-row">
      <button class="qp" onclick="quickSend('感情上有点迷茫')">感情迷茫</button>
      <button class="qp" onclick="quickSend('工作遇到瓶颈了')">工作瓶颈</button>
      <button class="qp" onclick="quickSend('说不上来的烦')">说不上来的烦</button>
      <button class="qp" onclick="quickSend('帮我抽牌看看')">抽牌</button>
    </div>
    <div class="input-row">
      <textarea id="userInput" placeholder="说点什么..." rows="1" onkeydown="handleKey(event)" oninput="autoResize(this)"></textarea>
      <button class="send-btn" onclick="sendMessage()">发送 →</button>
    </div>
  </div>
</div>

<script>
// --- 离线版 JS ---
const DECK=[
{name:'愚者',symbol:'○'},{name:'魔术师',symbol:'∞'},{name:'女祭司',symbol:'☽'},{name:'女皇',symbol:'♀'},
{name:'皇帝',symbol:'♂'},{name:'教皇',symbol:'†'},{name:'恋人',symbol:'♡'},{name:'战车',symbol:'⊕'},
{name:'力量',symbol:'◎'},{name:'隐者',symbol:'◈'},{name:'命运之轮',symbol:'✦'},{name:'正义',symbol:'⚖'},
{name:'倒吊人',symbol:'⊻'},{name:'死神',symbol:'◇'},{name:'节制',symbol:'≈'},{name:'恶魔',symbol:'⊗'},
{name:'塔',symbol:'⚡'},{name:'星星',symbol:'☆'},{name:'月亮',symbol:'◑'},{name:'太阳',symbol:'☉'},
{name:'审判',symbol:'◬'},{name:'世界',symbol:'◉'}];

const SPREADS={
default:{label:'指导+三情况',positions:['指导牌','情况一','情况二','情况三'],count:4},
cross:{label:'恋人十字',positions:['现状','挑战','过去','未来','建议'],count:5},
single:{label:'单张指引',positions:['今日指引'],count:1}
};

let messages=[];
let isTyping=false;
let currentSpread='default';
let pendingDeck=[];
let selectedCards=[];
let spreadPositions=[];
let pickingCards=false;

function setSpread(type){currentSpread=type;document.querySelectorAll('.tool-btn').forEach(b=>b.classList.remove('active'));document.getElementById('btn-'+type).classList.add('active');}

function shuffleDeck(){return [...DECK].sort(()=>Math.random()-0.5).map(c=>({...c,reversed:Math.random()>0.5}));}

function showBlindPick(){
  if(pickingCards) return;
  pickingCards=true;
  selectedCards=[];
  const sp=SPREADS[currentSpread];
  spreadPositions=sp.positions;
  pendingDeck=shuffleDeck();
  const area=document.getElementById('chatArea');
  const wrap=document.createElement('div');
  wrap.id='blindPick';
  wrap.style.cssText='display:flex;flex-direction:column;gap:0.6rem;margin:0.25rem 0;animation:fadeUp 0.4s ease forwards;opacity:0;';
  const hint=document.createElement('div');
  hint.style.cssText='font-family:Space Mono,monospace;font-size:9px;letter-spacing:0.18em;color:#7a7060;text-transform:uppercase;';
  hint.id='pickHint';
  hint.textContent='心里想着问题 · 点选 '+sp.count+' 张牌 （已选 0/'+sp.count+'）';
  wrap.appendChild(hint);
  const row=document.createElement('div');
  row.style.cssText='display:flex;gap:0.5rem;flex-wrap:wrap;';
  for(let i=0;i<10;i++){
    const tc=document.createElement('div');
    tc.className='tarot-card face-down';
    tc.style.cursor='pointer';
    tc.dataset.idx=i;
    tc.addEventListener('click',()=>onCardPick(tc,i,sp.count));
    row.appendChild(tc);
  }
  wrap.appendChild(row);
  area.appendChild(wrap);
  area.scrollTop=area.scrollHeight;
}

function onCardPick(el,deckIdx,total){
  if(!pickingCards) return;
  if(el.classList.contains('revealed')) return;
  if(selectedCards.length>=total) return;
  const card=pendingDeck[deckIdx];
  selectedCards.push(card);
  el.classList.remove('face-down'); el.classList.add('revealed');
  if(card.reversed) el.classList.add('reversed');
  el.style.cursor='default';
  const inner=document.createElement('div'); inner.className='card-inner';
  const sym=document.createElement('div'); sym.className='card-symbol'; sym.textContent=card.symbol;
  const nm=document.createElement('div'); nm.className='card-name-sm'; nm.textContent=card.name;
  const ori=document.createElement('div'); ori.className='card-ori-sm'; ori.textContent=card.reversed?'逆位':'正位';
  inner.appendChild(sym); inner.appendChild(nm); inner.appendChild(ori);
  el.appendChild(inner);
  const hint=document.getElementById('pickHint');
  if(hint) hint.textContent='心里想着问题 · 点选 '+total+' 张牌 （已选 '+selectedCards.length+'/'+total+'）';
  if(selectedCards.length===total){
    pickingCards=false;
    setTimeout(()=>labelSelectedCards(selectedCards,spreadPositions),300);
    setTimeout(()=>sendCardReading(selectedCards,SPREADS[currentSpread]),500);
  }
}

function labelSelectedCards(cards,positions){
  const area=document.getElementById('chatArea');
  const posRow=document.createElement('div');
  posRow.style.cssText='display:flex;gap:0.5rem;flex-wrap:wrap;margin-top:0.25rem;';
  cards.forEach((c,i)=>{
    const lbl=document.createElement('div');
    lbl.style.cssText='width:52px;font-family:Space Mono,monospace;font-size:7px;color:#7a7060;text-align:center;letter-spacing:0.06em;';
    lbl.textContent=positions[i]||'';
    posRow.appendChild(lbl);
  });
  const pick=document.getElementById('blindPick');
  if(pick) pick.appendChild(posRow);
}

function sendCardReading(cards,spread){
  const desc=cards.map((c,i)=>spread.positions[i]+': '+c.name+'（'+(c.reversed?'逆位':'正位')+'）').join('，');
  addMsg('ai','[离线模式] 你抽了牌：'+desc+'。AI解读功能在离线状态下不可用。');
}

function addMsg(role,text){
  const area=document.getElementById('chatArea');
  const div=document.createElement('div');
  div.className='message '+role; div.style.animationDelay='0s';
  const lbl=document.createElement('div'); lbl.className='msg-label'; lbl.textContent=role==='user'?'你':'22';
  const b=document.createElement('div'); b.className='msg-bubble'; b.textContent=text;
  div.appendChild(lbl); div.appendChild(b); area.appendChild(div); area.scrollTop=area.scrollHeight;
}

function quickSend(text){document.getElementById('userInput').value=text; sendMessage();}
function autoResize(el){el.style.height='auto'; el.style.height=Math.min(el.scrollHeight,96)+'px';}
function handleKey(e){if(e.key==='Enter'&&!e.shiftKey){e.preventDefault(); sendMessage();}}
function sendMessage(){
  const input=document.getElementById('userInput'); const text=input.value.trim();
  if(!text) return;
  input.value=''; input.style.height='auto';
  addMsg('user',text);
  // 离线 AI 提示
  if(text.includes('抽牌')||text.includes('看看')){ setTimeout(()=>showBlindPick(),300); }
  else{ addMsg('ai','[离线模式] AI解读暂不可用'); }
}
</script>
</body>
</html>
